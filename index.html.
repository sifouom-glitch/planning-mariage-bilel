<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Missions du Mariage 💍</title>
  <style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #f4f6f9; margin: 0; padding: 15px; }
    .header { text-align: center; margin-bottom: 20px; }
    h1 { color: #2c3e50; margin-bottom: 5px; }
    p { color: #7f8c8d; margin-top: 0; }
    .card { background: white; padding: 15px; border-radius: 12px; margin-bottom: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); display: flex; justify-content: space-between; align-items: center; }
    .info { flex-grow: 1; }
    .name { font-size: 1.1em; font-weight: bold; color: #333; }
    .task { color: #555; margin: 4px 0; }
    .time { font-size: 0.9em; font-weight: bold; color: #3498db; }
    .btn { padding: 12px 18px; border-radius: 8px; border: none; font-weight: bold; cursor: pointer; color: white; transition: 0.3s; font-size: 0.95em; min-width: 110px; }
    .btn-red { background-color: #e74c3c; box-shadow: 0 3px 0 #c0392b; }
    .btn-green { background-color: #2ecc71; box-shadow: 0 3px 0 #27ae60; }
  </style>
</head>
<body>

  <div class="header">
    <h1>💍 Planning du Mariage</h1>
    <p>Cliquez sur votre tâche pour la passer en vert quand c'est fait !</p>
  </div>

  <div id="task-list"></div>

  <!-- Synchronisation en direct pour tout le monde -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getDatabase, ref, onValue, set } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

    // Base de données publique temporaire pour le mariage
    const firebaseConfig = { databaseURL: "https://mariage-tasks-default-rtdb.europe-west1.firebasedatabase.app" };
    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);
    const tasksRef = ref(db, 'mariage_frere_tasks');

    // Tâches de base (modifie les noms et heures ici si tu veux !)
    const initialTasks = [
      { id: 1, nom: "Tonton Marc", heure: "10h30", task: "Récupérer la pièce montée", status: "rouge" },
      { id: 2, nom: "Sarah (Cousine)", heure: "12h00", task: "Déposer les fleurs à la salle", status: "rouge" },
      { id: 3, nom: "Karim", heure: "14h00", task: "Guider les invités au parking", status: "rouge" },
      { id: 4, nom: "Maman", heure: "15h30", task: "Vérifier la sono et micros", status: "rouge" }
    ];

    // Écouter les changements en temps réel
    onValue(tasksRef, (snapshot) => {
      const data = snapshot.val();
      if (!data) {
        set(tasksRef, initialTasks);
        return;
      }
      render(data);
    });

    window.toggleTask = function(index, currentStatus) {
      const newStatus = currentStatus === 'rouge' ? 'vert' : 'rouge';
      set(ref(db, `mariage_frere_tasks/${index}/status`), newStatus);
    };

    function render(tasks) {
      const container = document.getElementById("task-list");
      container.innerHTML = "";
      tasks.forEach((t, i) => {
        const isVert = t.status === "vert";
        container.innerHTML += `
          <div class="card">
            <div class="info">
              <div class="name">${t.nom}</div>
              <div class="task">${t.task}</div>
              <div class="time">⏰ ${t.heure}</div>
            </div>
            <button class="btn ${isVert ? 'btn-green' : 'btn-red'}" onclick="toggleTask(${i}, '${t.status}')">
              ${isVert ? '✔ Terminé' : '✖ À faire'}
            </button>
          </div>
        `;
      });
    }
  </script>
</body>
</html>
